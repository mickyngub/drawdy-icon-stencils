{
    "name": "drawdy-icon-stencils",
    "version": "1.0.0",
    "description": "Icon Stencils for Drawdy: UI and wireframe line icons from Lucide, grouped by category, to drag or click onto the board.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node build.ts",
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit",
        "preflight": "node scripts/preflight.mjs",
        "lucide-categories": "node scripts/lucide-categories.mjs",
        "check-lucide-categories": "node scripts/lucide-categories.mjs --check"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "latest",
        "@rollup/plugin-typescript": "^12.1.2",
        "@types/node": "^24",
        "fflate": "^0.8.2",
        "rollup": "^4.34.0",
        "tslib": "^2.8.1",
        "tsx": "^4.20.0",
        "typescript": "^5",
        "vite": "^8.2.1"
    }
}
